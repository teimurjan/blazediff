{
	"name": "@blazediff/core",
	"version": "2.0.3",
	"description": "Blazing-fast pixel-by-pixel image comparison. About 7x faster than pixelmatch, with the same output",
	"private": false,
	"publishConfig": {
		"access": "public"
	},
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./pixelmatch": {
			"import": {
				"types": "./dist/pixelmatch.d.mts",
				"default": "./dist/pixelmatch.mjs"
			},
			"require": {
				"types": "./dist/pixelmatch.d.ts",
				"default": "./dist/pixelmatch.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"keywords": [
		"image",
		"comparison",
		"diff",
		"pixel",
		"visual-testing"
	],
	"author": "Teimur Gasanov <me@teimurjan.dev> (https://github.com/teimurjan)",
	"repository": "https://github.com/teimurjan/blazediff",
	"homepage": "https://blazediff.dev",
	"license": "MIT",
	"dependencies": {
		"@blazediff/contract": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"@types/pngjs": "^6.0.5",
		"@vitest/coverage-v8": "^3.2.4",
		"pixelmatch": "8.0.0",
		"pngjs": "^7.0.0",
		"tsup": "8.5.0",
		"typescript": "5.9.2",
		"vitest": "^3.2.4"
	}
}
