{
	"name": "@blazediff/root",
	"version": "0.0.1",
	"description": "",
	"main": "index.js",
	"scripts": {
		"postinstall": "node ./scripts/dev/link-local-platform-native.js && node ./scripts/dev/link-local-core-native.js",
		"build": "pnpm -r --filter=!@blazediff/website build",
		"build:rust": "cd crates/blazediff && ./scripts/build-all.sh --all --napi",
		"build:rust:ssim": "cd crates/blazediff-ssim && ./scripts/build-napi.sh --all",
		"build:rust:interpret": "cd crates/blazediff-interpret && ./scripts/build-napi.sh --all",
		"build:rust:milo": "cd crates/blazediff-milo && ./scripts/build-napi.sh --all",
		"build:wasm": "cd crates/blazediff && ./scripts/build-wasm.sh",
		"build:wasm:interpret": "cd crates/blazediff-interpret && ./scripts/build-wasm.sh",
		"build:wasm:milo": "cd crates/blazediff-milo && ./scripts/build-wasm.sh",
		"build:python": "cd crates/blazediff && ./scripts/build-maturin.sh",
		"build:python:all": "cd crates/blazediff && ./scripts/build-maturin.sh --all",
		"build:python:ssim": "cd crates/blazediff-ssim && ./scripts/build-maturin.sh",
		"build:python:ssim:all": "cd crates/blazediff-ssim && ./scripts/build-maturin.sh --all",
		"build:python:interpret": "cd crates/blazediff-interpret && ./scripts/build-maturin.sh",
		"build:python:interpret:all": "cd crates/blazediff-interpret && ./scripts/build-maturin.sh --all",
		"build:python:milo": "cd crates/blazediff-milo && ./scripts/build-maturin.sh",
		"build:python:milo:all": "cd crates/blazediff-milo && ./scripts/build-maturin.sh --all",
		"release:pypi": "node scripts/release/publish-pypi.js",
		"setup:npm-oidc": "node scripts/release/setup-npm-oidc.js",
		"restore": "node scripts/release/restore-artifacts.js",
		"test": "pnpm -r test",
		"test:python": "./scripts/checks/test-python.sh",
		"typecheck": "pnpm -r typecheck",
		"changeset": "changeset",
		"version": "changeset version && node scripts/release/sync-cargo-version.js && node scripts/release/sync-pyproject-version.js",
		"release": "changeset publish && node scripts/release/publish-rust.js && deno run -A scripts/release/publish-jsr.ts && node scripts/release/publish-pypi.js",
		"deno:test": "deno test --allow-all --no-check",
		"benchmark": "node scripts/bench/run.js",
		"examples:vitest": "pnpm --filter @blazediff/matcher-examples vitest",
		"examples:jest": "pnpm --filter @blazediff/matcher-examples jest",
		"examples:bun": "pnpm --filter @blazediff/matcher-examples bun",
		"examples:all": "pnpm --filter @blazediff/matcher-examples all",
		"format": "pnpm exec biome format",
		"format:write": "pnpm exec biome format --write",
		"check": "pnpm exec biome check",
		"check:write": "pnpm exec biome check --write",
		"lint": "pnpm exec biome lint",
		"lint:write": "pnpm exec biome lint --write",
		"lint:unsafewrite": "pnpm exec biome lint --unsafe  --write",
		"video:render": "pnpm --filter @blazediff/video render",
		"video:studio": "pnpm --filter @blazediff/video studio"
	},
	"keywords": [],
	"author": "Teimur Gasanov <me@teimurjan.dev> (https://github.com/teimurjan)",
	"repository": "https://github.com/teimurjan/blazediff",
	"homepage": "https://blazediff.dev",
	"license": "MIT",
	"packageManager": "pnpm@10.8.1",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@changesets/changelog-git": "^0.2.1",
		"@changesets/cli": "^2.29.6",
		"@j178/prek": "^0.3.6",
		"@types/node": "^24.3.0"
	},
	"workspaces": [
		"packages/*",
		"packages/core-native/*",
		"packages/ssim-native/*",
		"packages/interpret-native/*",
		"packages/milo-native/*",
		"apps/*",
		"examples/*",
		"crates/blazediff",
		"crates/blazediff-interpret",
		"crates/blazediff-milo",
		"crates/blazediff-shared",
		"crates/blazediff-png",
		"crates/blazediff-ssim"
	]
}
